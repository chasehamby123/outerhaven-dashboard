{
  "manifest_version": 3,
  "name": "OuterHaven HQ: save LinkedIn chats",
  "short_name": "OuterHaven HQ",
  "version": "2.1.0",
  "description": "Saves LinkedIn chats to OuterHaven HQ (which DMs book meetings) and syncs the inbox list so HQ can show what is waiting on a reply. Only reads when you click.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "OuterHaven HQ", "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "host_permissions": ["https://nfcysxqdwpdhrdpgxrlo.supabase.co/*"],
  "content_scripts": [
    { "matches": ["https://www.linkedin.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
